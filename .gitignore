# Example .gitignore for projects using this workflow

# Environment variables
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependencies (language-specific - add as needed)
node_modules/
vendor/
target/
build/
dist/

# Test coverage
coverage/
*.coverage
.nyc_output/

# Temporary files
tmp/
temp/
*.tmp
